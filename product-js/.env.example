PORT=3100

# Optional: protect the UI/API with basic auth.
# If unset, auth is disabled.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Maximum automatic MCP/function calls the Gemini SDK may make while answering.
# Increase this for multi-step analytics that need several searches and calculations.
GEMINI_MAX_TOOL_STEPS=50

# JSONL debug log for frontend requests and Gemini -> MCP tool calls.
# Defaults to product-js/data/debug-events.jsonl.
DEBUG_LOG_FILE=
DEBUG_LOG_MAX_CHARS=20000
# Show compact "what I understood + MCP tool calls" in frontend answers.
# Keep false for manager-facing production UI; JSONL logs still capture details.
DEBUG_TRACE_IN_RESPONSE=false

# If you want to use Vertex AI instead of Gemini API key auth:
# - Set GOOGLE_GENAI_USE_VERTEXAI=true
# - Provide GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION
# - Ensure ADC works (GOOGLE_APPLICATION_CREDENTIALS or gcloud ADC)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: if UI doesn't send a customerId, this will be used as the default.
DEFAULT_CUSTOMER_ID=

# Python to run the MCP server via stdio.
# If empty: defaults to `python` on Windows and `python3` on Linux/macOS.
MCP_PYTHON=

# Optional: override how the MCP server is launched.
# If set, this is used instead of `python -m ads_mcp.server`.
# Example (Windows):
#   MCP_SERVER_COMMAND=pipx
#   MCP_SERVER_ARGS=["run","--spec","git+https://github.com/googleads/google-ads-mcp.git","google-ads-mcp"]
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional (only if your access is through a manager/MCC):
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
